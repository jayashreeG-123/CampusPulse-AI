# Copy this file to .env and replace the secret with a long random value.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=0
FLASK_DEBUG=0
PORT=5000

# Choose: auto, ollama, cloud, or off
LLM_PROVIDER=auto

# Local Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional OpenAI-compatible cloud endpoint
CLOUD_API_KEY=
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-4o-mini
LLM_TIMEOUT=45
